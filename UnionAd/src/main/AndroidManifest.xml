<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    ═══════════════════════════════════════════════════════════════════════
    FsUnionAd 聚合广告 SDK — AndroidManifest
    ═══════════════════════════════════════════════════════════════════════

    聚合 SDK 自身仅需以下两个基础权限（云配置拉取 / 网络状态判断），
    接入方引入 UnionAd 依赖后会自动合并到主工程，无需手动添加。

    各广告平台 SDK（穿山甲/优量汇/百青藤/飞梭）的权限与组件声明
    （Activity / Service / Provider / Receiver）由其各自 AAR 的 Manifest
    声明后自动合并到主工程；需要接入方在 app 模块中手动补充的声明
    （如优量汇 GDTFileProvider、百青藤权限、飞梭 INTERNET 权限等），
    详见《接入文档》§2.3「各联盟 SDK Manifest 配置」。
    ═══════════════════════════════════════════════════════════════════════
    -->

    <!-- ── 基础权限（聚合 SDK 自身必需） ───────────────────────────────── -->
    <!-- 云配置拉取 / 广告策略请求 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络状态判断（决定是否发起云配置请求） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
