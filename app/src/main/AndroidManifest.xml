<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══ 权限声明 ══════════════════════════════════════════════════════
         聚合 SDK 自身仅需 INTERNET / ACCESS_NETWORK_STATE（由 UnionAd
         Manifest 自动合并）。以下权限为各广告平台填充率 / eCPM 所需，
         按需声明即可；各联盟权限归属详见《接入文档》§2.3
         「各联盟 SDK Manifest 配置」。
         ══════════════════════════════════════════════════════════════ -->
    <!-- 聚合 SDK + 各联盟通用：网络访问与状态 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 穿山甲（AAR 已自带网络/存储/WiFi/震动/唤醒锁，此处补充官方推荐的设备信息权限） -->
    <!-- 百青藤（AAR 未声明任何权限，以下全部需手动声明） -->
    <!-- 优量汇（AAR 已自带粗定位/安装/包可见性等） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 穿山甲自定义权限（AAR 已声明，此处显式声明与官方文档保持一致） -->
    <permission
        android:name="${applicationId}.openadsdk.permission.TT_PANGOLIN"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.openadsdk.permission.TT_PANGOLIN" />

    <application
        android:name=".FsUnionAdApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        tools:replace="android:allowBackup"
        android:theme="@style/Theme.FsUnionAd">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FsUnionAd">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ══ 各广告格式独立 Demo 页 ═══════════════════════ -->
        <activity
            android:name=".SplashAdActivity"
            android:exported="false"
            android:label="开屏广告 Splash"
            android:theme="@style/Theme.FsUnionAd" />

        <activity
            android:name=".InterstitialAdActivity"
            android:exported="false"
            android:label="插屏广告 Interstitial"
            android:theme="@style/Theme.FsUnionAd" />

        <activity
            android:name=".RewardedVideoAdActivity"
            android:exported="false"
            android:label="激励视频 Rewarded Video"
            android:theme="@style/Theme.FsUnionAd" />

        <activity
            android:name=".FeedTemplateAdActivity"
            android:exported="false"
            android:label="信息流模板 Feed Template"
            android:theme="@style/Theme.FsUnionAd" />

        <activity
            android:name=".FeedRenderAdActivity"
            android:exported="false"
            android:label="信息流自渲染 Feed Render"
            android:theme="@style/Theme.FsUnionAd" />

        <!-- ══ 联盟 SDK 需手动配置的组件 ═══════════════════════════════
             穿山甲 / 飞梭组件由其 AAR Manifest 自动合并，无需手动声明。
             优量汇 GDTFileProvider 未包含在 GDT AAR Manifest 中，
             接入方必须手动声明；@xml/gdt_file_path 资源由 GDT AAR 自带，
             无需自行创建。
             ══════════════════════════════════════════════════════════ -->
        <!-- 优量汇 FileProvider -->
        <provider
            android:name="com.qq.e.comm.GDTFileProvider"
            android:authorities="${applicationId}.gdt.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/gdt_file_path" />
        </provider>
        <!-- 优量汇 targetSdk >= 28 必需 -->
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

    </application>

</manifest>
