<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Top App Bar ─────────────────────────────────── -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:elevation="0dp"
            android:background="@android:color/transparent"
            app:title="FsUnionSDK Demo"
            app:titleTextAppearance="@style/ToolbarTitle"
            app:titleTextColor="@color/primary" />

        <!-- ── Scrollable Body ─────────────────────────────── -->
        <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ══ Platform Integration Cards (Dynamic) ══════ -->
                <GridLayout
                    android:id="@+id/platform_cards_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginBottom="10dp"
                    android:useDefaultMargins="false" />

                <!-- ══ Ad Format Navigation ═══════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DemoCard"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ad Format Demo Pages"
                            android:textAppearance="@style/SectionTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="每种广告格式独立页面，含完整日志输出"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_nav_splash"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:paddingStart="16dp"
                            android:singleLine="true"
                            android:text="开屏广告 (Splash)"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_nav_inter"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:paddingStart="16dp"
                            android:singleLine="true"
                            android:text="插屏广告 (Interstitial)"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_nav_reward"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:paddingStart="16dp"
                            android:singleLine="true"
                            android:text="激励视频 (Rewarded)"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_nav_feed_tp"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:paddingStart="16dp"
                            android:singleLine="true"
                            android:text="信息流模板 (Feed Template)"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_nav_feed_rd"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:paddingStart="16dp"
                            android:singleLine="true"
                            android:text="信息流自渲染 (Feed Render)"
                            android:textSize="15sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ══ Global Logs ════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DemoCard"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline_variant"
                    android:visibility="gone"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Platform Init Logs"
                                android:textAppearance="@style/SectionTitle"
                                android:textColor="@color/primary" />

                            <Button
                                android:id="@+id/btn_clear_logs"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Clear"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.core.widget.NestedScrollView
                            android:id="@+id/logs_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/log_background"
                            android:fillViewport="false"
                            android:maxHeight="240dp"
                            android:minHeight="120dp">

                            <TextView
                                android:id="@+id/logs_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:lineSpacingExtra="3sp"
                                android:padding="16dp"
                                android:text="等待初始化..."
                                android:textColor="@color/log_text"
                                android:textSize="11sp" />
                        </androidx.core.widget.NestedScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
