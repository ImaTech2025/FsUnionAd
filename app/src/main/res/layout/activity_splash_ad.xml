<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ── Main Content Layer ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="开屏广告 Splash"
            app:titleTextAppearance="@style/ToolbarTitle"
            app:titleTextColor="@color/primary"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationContentDescription="返回" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ══ Platform Selector ══════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DemoCard"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/secondary_container">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ad Source"
                            android:textAppearance="@style/SectionTitle" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/source_chip_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:singleSelection="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ══ Strategy Selector ═════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DemoCard"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/fission_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ad Strategy"
                            android:textAppearance="@style/SectionTitle" />

                        <RadioGroup
                            android:id="@+id/strategy_radio_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <RadioButton
                                android:id="@+id/radio_strategy_waterfall"
                                style="@style/FormatRadio"
                                android:checked="true"
                                android:text="Waterfall 瀑布流" />

                            <RadioButton
                                android:id="@+id/radio_strategy_bidding"
                                style="@style/FormatRadio"
                                android:text="Bidding 实时竞价" />

                            <RadioButton
                                android:id="@+id/radio_strategy_hybrid"
                                style="@style/FormatRadio"
                                android:text="Hybrid 混合竞价" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ══ Info Card ═════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DemoCard"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/tertiary_container">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="当前配置"
                            android:textAppearance="@style/SectionTitle" />

                        <TextView
                            android:id="@+id/info_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:text="AppID: --\nSlotID: --\nStrategy: Waterfall"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ══ Actions ════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DemoCard"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Actions"
                            android:textAppearance="@style/SectionTitle" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_load_show"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:text="Load and Show Splash"
                            android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ══ Logs ══════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DemoCard"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Logs"
                                android:textAppearance="@style/SectionTitle"
                                android:textColor="@color/primary" />

                            <Button
                                android:id="@+id/btn_clear_logs"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Clear"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.core.widget.NestedScrollView
                            android:id="@+id/logs_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/log_background"
                            android:fillViewport="false"
                            android:maxHeight="260dp"
                            android:minHeight="140dp">

                            <TextView
                                android:id="@+id/logs_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:lineSpacingExtra="3sp"
                                android:padding="16dp"
                                android:text="等待操作..."
                                android:textColor="@color/log_text"
                                android:textSize="11sp" />
                        </androidx.core.widget.NestedScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ═════════════════════════════════════════════════════
         Splash Overlay (hidden by default)
         ═════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@drawable/splash_gradient"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FsUnionSDK"
                android:textColor="@color/splash_text"
                android:textSize="40sp"
                android:textStyle="bold"
                android:alpha="0.95" />

            <TextView
                android:id="@+id/splash_source_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text=""
                android:textColor="@color/splash_text"
                android:textSize="16sp"
                android:alpha="0.75" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_skip_splash"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:layout_marginTop="60dp"
                android:text="Skip →"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                android:backgroundTint="@color/white" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_splash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="24dp"
            android:background="@drawable/splash_close_bg"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/splash_text" />
    </FrameLayout>

</FrameLayout>
